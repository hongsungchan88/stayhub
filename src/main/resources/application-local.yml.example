# ┌─────────────────────────────────────────────────────────────────┐
# │ 이 파일을 같은 폴더에 복사한 뒤 이름을 application-local.yml 로   │
# │ 바꾸고, 아래 비밀번호를 본인 것으로 채우세요.                     │
# │                                                                 │
# │ application-local.yml 은 .gitignore 에 등록돼 있어 커밋되지      │
# │ 않습니다. 비밀번호가 GitHub 에 올라갈 걱정은 하지 않아도 됩니다. │
# └─────────────────────────────────────────────────────────────────┘

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/stayhub?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 여기에 MySQL 설치할 때 정한 비밀번호
